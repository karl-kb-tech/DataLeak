# Copy to .env.local and fill in. All values are OPTIONAL — the tool runs
# keyless by default (LeakCheck + XposedOrNot only).

# Have I Been Pwned breach API (paid). When set, /api/breaches also queries
# HIBP for richer results (data classes, dates, descriptions). When unset,
# HIBP is skipped entirely.
# HIBP_API_KEY=

# LeakCheck Pro API key. Reserved for a future upgrade from the public API.
# LEAKCHECK_API_KEY=
